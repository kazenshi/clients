+      if (
+        Object.keys(params.extensions?.prf?.evalByCredential ?? {}).some((k) => {
+          if (!k) {
+            return true;
+          }
+
+          try {
+            Fido2Utils.stringToArray(k);
+            return !params.allowCredentialDescriptorList.some(
+              (e) => Fido2Utils.arrayToString(e.id) === k,
+            );
+          } catch {
+            return true;
+          }
+        })
